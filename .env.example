# PostgreSQL local instalado no Windows
DATABASE_URL="postgresql://monitor:monitor_dev@localhost:5432/monitoramento?schema=public"
API_PORT=3000
# Em producao, defina a origem HTTPS publica do painel.
DASHBOARD_ORIGIN="http://localhost:5173"
SESSION_SECRET="replace-with-at-least-32-random-characters"
INGESTION_API_KEY="replace-with-a-different-long-random-key"
# Use true em producao atras de HTTPS; mantenha false apenas no desenvolvimento local HTTP.
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL="admin@laboratorio.local"
BOOTSTRAP_ADMIN_PASSWORD="Change-this-password-123!"

# SMTP necessario para entregar links de recuperacao de senha
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="seu-usuario-smtp"
SMTP_PASSWORD="sua-senha-smtp"
SMTP_FROM="LAB/MONITOR <no-reply@example.com>"
