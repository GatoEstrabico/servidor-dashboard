# PostgreSQL local instalado no Windows
DATABASE_URL="postgresql://monitor:monitor_dev@localhost:5432/monitoramento?schema=public"
API_PORT=3000
# Permite que usuarios autenticados adicionem arquivos a biblioteca compartilhada de sons.
ALERT_AUDIO_UPLOAD_ENABLED=true
SHOW_WORKSPACE_SETUP_WHEN_EMPTY=true
# Logs da API: categorias podem ser desligadas independentemente.
API_LOG_LEVEL=info
API_LOG_SERVER=true
API_LOG_WHATSAPP=true
API_LOG_LIBSIGNAL=false
API_LOG_TO_FILE=true
API_LOG_FILE_PATH=.data/logs/api.log
# Em producao, defina a origem HTTPS publica do painel.
DASHBOARD_ORIGIN="http://localhost:5173"
# URL usada nos links enviados por e-mail. Em testes na rede, troque pelo IP LAN do computador; em produção, use HTTPS.
DASHBOARD_PUBLIC_URL="http://localhost:5173"
SESSION_SECRET="replace-with-at-least-32-random-characters"
INGESTION_API_KEY="replace-with-a-different-long-random-key"
# Use true em producao atras de HTTPS; mantenha false apenas no desenvolvimento local HTTP.
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL="admin@laboratorio.local"
BOOTSTRAP_ADMIN_PASSWORD="Change-this-password-123!"

# SMTP necessario para entregar links de recuperacao de senha
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="seu-usuario-smtp"
SMTP_PASSWORD="sua-senha-smtp"
SMTP_FROM="LAB/MONITOR <no-reply@example.com>"

# WhatsApp Cloud API oficial da Meta (opcional; descomente e configure os dois primeiros valores)
# WHATSAPP_ACCESS_TOKEN="token-de-acesso-da-meta"
# WHATSAPP_PHONE_NUMBER_ID="id-do-numero-na-cloud-api"
# WHATSAPP_API_VERSION="v23.0"
# WHATSAPP_TEMPLATE_NAME="lab_monitor_alarm"
# WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
# Para o número de teste da Meta, use o modelo padrão abaixo:
# WHATSAPP_TEMPLATE_NAME="hello_world"
# WHATSAPP_TEMPLATE_LANGUAGE="en_US"
