generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  displayName    String               @default("Usuario")
  avatarDataUrl  String?              @db.Text
  alertSoundDataUrl String?            @db.Text
  alertSoundName String?
  onlineAlertSoundId String?
  warningAlertSoundId String?
  offlineAlertSoundId String?
  whatsappNumber String?
  emailNotifications    Boolean       @default(true)
  whatsappNotifications Boolean       @default(false)
  isPlatformAdmin Boolean             @default(false)
  passwordResetRequired Boolean        @default(false)
  activeWorkspaceId String?
  passwordHash   String
  createdAt      DateTime             @default(now())
  emailVerifiedAt DateTime?
  sessions       Session[]
  deviceLinks    DeviceLink[]
  resetTokens    PasswordResetToken[]
  notifications  DeviceNotification[]
  memberships    WorkspaceMember[]
  ownedDevices   Device[] @relation("DeviceOwner")
  sentInvitations WorkspaceInvitation[] @relation("InvitationCreator")
  activeWorkspace Workspace? @relation("CurrentWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  csrfHash   String
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id         String    @id @default(cuid())
  externalId String    @unique
  name       String
  alias      String?
  location   String?
  status     String    @default("online")
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  workspaceId String?
  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  ownerUserId String?
  owner       User?     @relation("DeviceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  readings   Reading[]
  deviceLink DeviceLink?
  notificationPreferences DeviceNotificationPreference[]
  notifications DeviceNotification[]

  @@index([workspaceId, status, lastSeenAt])
  @@index([ownerUserId])
}

model DeviceLink {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  deviceId  String   @unique
  userId    String
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reading {
  id         String   @id @default(cuid())
  deviceId   String
  type       String
  value      Float
  unit       String
  alert      Boolean  @default(false)
  recordedAt DateTime
  createdAt  DateTime @default(now())
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt(sort: Desc)])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  accessCode  String?  @unique
  iconDataUrl String?  @db.Text
  createdAt   DateTime @default(now())
  memberships WorkspaceMember[]
  invitations WorkspaceInvitation[]
  devices     Device[]
  notifications DeviceNotification[]
  activeUsers User[] @relation("CurrentWorkspace")
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        String   @default("member")
  notifyAllDevices Boolean @default(true)
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceNotificationPreferences DeviceNotificationPreference[]

  @@id([workspaceId, userId])
  @@index([userId])
}

model DeviceNotificationPreference {
  workspaceId String
  userId      String
  deviceId    String
  emailEnabled Boolean @default(false)
  whatsappEnabled Boolean @default(false)
  workspaceMember WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId, deviceId])
  @@index([deviceId])
}

model DeviceNotification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  deviceId    String?
  deviceName  String
  status      String
  title       String
  message     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  device      Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, workspaceId, createdAt(sort: Desc)])
  @@index([userId, workspaceId, readAt])
}

model WorkspaceInvitation {
  id              String   @id @default(cuid())
  workspaceId     String
  createdByUserId String
  email           String
  role            String   @default("member")
  tokenHash       String   @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([expiresAt])
}

model PendingRegistration {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  passwordHash String
  workspaceName String?
  workspaceId String?
  invitationId String? @unique
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

model GlobalSetting {
  id                       String   @id @default("global")
  publicRegistrationEnabled Boolean @default(false)
  updatedAt                DateTime @updatedAt
}
