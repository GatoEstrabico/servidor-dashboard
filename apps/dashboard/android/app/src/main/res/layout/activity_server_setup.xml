<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="LAB / MONITOR"
                android:textColor="#287B65"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Servidor do dashboard"
                android:textColor="#202927"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Informe o IP do computador que está executando o dashboard."
                android:textColor="#65716B"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:labelFor="@id/server_ip_input"
                android:text="IP do servidor"
                android:textColor="#38443F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/server_ip_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints=""
                android:hint="192.168.1.99"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="#202927"
                android:textColorHint="#9AA49D" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Conexão de debug pela porta 5173, em HTTP e na rede local."
                android:textColor="#79847E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/server_ip_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Digite um endereço IPv4 válido, por exemplo 192.168.1.99."
                android:textColor="#AE4847"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/server_connect_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#287B65"
                android:text="Conectar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>