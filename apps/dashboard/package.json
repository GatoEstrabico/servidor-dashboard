{
  "name": "@monitoramento/dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "cap add android",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "npm run android:sync && node scripts/build-android-debug.mjs",
    "android:build:release": "node scripts/build-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "libphonenumber-js": "^1.13.15",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "vite": "^6.2.5",
    "vue-tsc": "^2.2.8"
  }
}
